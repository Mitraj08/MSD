{
  "info": {
    "name": "Student Records Management API",
    "description": "CRUD endpoints for the Student Records Management API (Express.js). Import this collection into Postman and use the {{baseUrl}} variable (defaults to http://localhost:5000).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000", "type": "string" },
    { "key": "studentId", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "API Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/", "host": ["{{baseUrl}}"], "path": [""] }
      }
    },
    {
      "name": "Get All Students",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/students",
          "host": ["{{baseUrl}}"],
          "path": ["api", "students"]
        }
      }
    },
    {
      "name": "Filter Students by Course & Year",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/students?course=Computer Science&year=2",
          "host": ["{{baseUrl}}"],
          "path": ["api", "students"],
          "query": [
            { "key": "course", "value": "Computer Science" },
            { "key": "year", "value": "2" }
          ]
        }
      }
    },
    {
      "name": "Get Student By ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/students/{{studentId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "students", "{{studentId}}"]
        }
      }
    },
    {
      "name": "Create Student",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Rohan Verma\",\n  \"rollNumber\": \"CS2023099\",\n  \"email\": \"rohan.verma@example.com\",\n  \"course\": \"Computer Science\",\n  \"year\": 1,\n  \"gpa\": 8.2\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/students",
          "host": ["{{baseUrl}}"],
          "path": ["api", "students"]
        }
      }
    },
    {
      "name": "Update Student",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"year\": 2,\n  \"gpa\": 8.9\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/students/{{studentId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "students", "{{studentId}}"]
        }
      }
    },
    {
      "name": "Delete Student",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/students/{{studentId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "students", "{{studentId}}"]
        }
      }
    },
    {
      "name": "Create Student - Validation Error Example",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"\",\n  \"email\": \"not-an-email\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/students",
          "host": ["{{baseUrl}}"],
          "path": ["api", "students"]
        }
      }
    }
  ]
}
