# Rename this file to .env and fill in your own values.
# Never commit your real .env file to version control.

# Your MongoDB Atlas connection string.
# In Atlas: Database > Connect > Drivers > copy the connection string,
# then replace <username>, <password>, and add your database name.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/employee_management?retryWrites=true&w=majority

# Port the Express server listens on
PORT=5000
